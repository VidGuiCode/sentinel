# Cut-capability test image.
#
# Copy the source in, do not bind-mount it: Docker Desktop for Windows
# serves bind mounts through a file system that returns EINVAL from
# getdents when the call runs with no root rights or with dropped
# rights. Those are the exact test cases. Baked-in files keep the
# test about Sentinel, not about the host mount driver.
FROM sentinel-bench
COPY sentinel-monitor.py /opt/sentinel/sentinel-monitor.py
COPY bench/capture_frame.py /opt/sentinel/bench/capture_frame.py
WORKDIR /opt/sentinel

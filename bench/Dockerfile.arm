# ARM smoke-test image (aarch64 and armv7).
#
# Build it with `docker build --platform linux/arm64` (or linux/arm/v7).
# Run it under QEMU user-mode emulation through binfmt_misc. This checks
# that Sentinel *runs* on ARM: imports, /proc and /sys reads, curses
# draw, both start modes. It says nothing about ARM speed: QEMU turns
# commands into slow host steps, so all times from this image mean nothing.
#
# Copy the source in, do not bind-mount it: read of a Docker Desktop
# for Windows bind mount from an emulated container is slow and can
# give EINVAL.
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 procps \
    && rm -rf /var/lib/apt/lists/*

COPY sentinel-monitor.py /opt/sentinel/sentinel-monitor.py
COPY bench/capture_frame.py /opt/sentinel/bench/capture_frame.py
WORKDIR /opt/sentinel

# ARM compatibility smoke-test image (aarch64 / armv7).
#
# Built with `docker build --platform linux/arm64` (or linux/arm/v7) and run
# under QEMU user-mode emulation via binfmt_misc. This validates that Sentinel
# *runs* on ARM - imports, /proc and /sys parsing, curses rendering, both
# entry-point modes. It says nothing about ARM performance: QEMU emulates
# instructions at a large and uneven slowdown, so timing numbers from this
# image are meaningless.
#
# The source is COPYed in rather than bind-mounted: emulated containers reading
# a Docker Desktop for Windows bind mount are both slow and prone to EINVAL.
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 procps \
    && rm -rf /var/lib/apt/lists/*

COPY sentinel-monitor.py /opt/sentinel/sentinel-monitor.py
COPY bench/capture_frame.py /opt/sentinel/bench/capture_frame.py
WORKDIR /opt/sentinel
